{
  "name": "tobal-flexy-desktop",
  "version": "1.0.0",
  "description": "Tobal Flexy Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "serve": "node server.js"
  },
  "dependencies": {
    "@dzcode-io/leblad": "^1.0.3",
    "acorn": "^8.16.0",
    "axios": "^1.16.0",
    "axios-ntlm": "^1.4.6",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "localtunnel": "^2.0.2",
    "node-telegram-bot-api": "^0.63.0",
    "puppeteer": "^25.0.4",
    "serialport": "^12.0.0",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^4.1.1"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.tobal.flexydesktop",
    "productName": "Tobal Flexy Desktop",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "ui/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tobal Flexy Desktop"
    },
    "files": [
      "**/*",
      "!meetmob_profile/**/*",
      "!.chrome_profile/**/*",
      "!.chrome_profile_1779057540752/**/*",
      "!.git/**/*",
      "!dist/**/*"
    ],
    "asar": false
  }
}
